{
  "name": "devrealm-desktop",
  "version": "1.0.0",
  "description": "DevRealm 桌面套壳（Electron），加载上级目录的单文件前端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.devrealm.app",
    "productName": "DevRealm",
    "files": [
      "main.js",
      "preload.js",
      "../index.html"
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
